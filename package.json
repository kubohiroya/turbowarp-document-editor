    "yaml": "2.9.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "0.25.12"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/yaml-ui.browser.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "bin": {
    "turbowarp-document-editor": "node/cli.mjs"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "sideEffects": [
    "./src/styles.js"
  ]
